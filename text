{
  "version": 3,
  "configurePresets": [
    {
      "name": "raspberry-pi-base",
      "hidden": true,
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "installDir": "${sourceDir}/out/install/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_CXX_STANDARD": "17",
        "OpenCV_DIR": "/usr/lib/arm-linux-gnueabihf/cmake/opencv4"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    },
    {
      "name": "pi-release",
      "displayName": "Raspberry Pi Release",
      "inherits": "raspberry-pi-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "pi-debug",
      "displayName": "Raspberry Pi Debug",
      "inherits": "raspberry-pi-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    }
  ]
}